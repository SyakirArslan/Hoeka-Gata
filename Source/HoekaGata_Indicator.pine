//@version=5
indicator("Engulfing Breakout - Arslan", overlay=true, max_lines_count=500, max_labels_count=500)

// ================= 1. PATTERN =================
g1 = "1. ENGULFING PATTERN"
patMode = input.string("Strict", "Pattern Mode", options=["Strict", "Loose"], group=g1)
minBodyX = input.float(1.2, "Minimum Body", minval=0.5, step=0.1, group=g1)
minBodyP = input.float(50.0, "Candle Body (%)", minval=0, maxval=100, step=5, group=g1)

// ================= 2. ENTRY =================
g2 = "2. ENTRY"
bufEntryX = input.float(0.10, "Breakout Tolerance Entry (ATR)", minval=0, step=0.01, group=g2)
bufSLX = input.float(0.10, "Breakout Tolerance SL (ATR)", minval=0, step=0.01, group=g2)
bodyBreakToleranceATR = input.float(0.00, "Body-Break Tolerance (ATR)", minval=0.0, step=0.01, group=g2)
cancelOpp = input.bool(true, "Cancel on Opposite Signal", group=g2)

// ================= 3. RISK & REWARD =================
g3 = "3. RISK & REWARD"
rrRatio = input.float(2.0, "Risk : Reward 1 :", minval=0.1, step=0.1, group=g3)

// ================= 4. DISPLAY (Entry / SL / TP) =================
g4 = "4. DISPLAY (Entry / SL / TP)"
showLines = input.bool(true, "Entry / SL / TP Lines", group=g4)
labelSizeInput = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group=g4)
lineStyleInput = input.string("Dashed", "Line Style", options=["Solid", "Dashed"], group=g4)
extendB = input.int(3, "Line Length", minval=0, maxval=50, group=g4)
keepN = input.int(3, "Displayed Setups", minval=1, maxval=100, group=g4)

// ================= 4b. RESULTS SUMMARY =================
g4b = "4b. RESULTS SUMMARY"
showTable = input.bool(true, "Show Panel", group=g4b)
panelSizeInput = input.string("Small", "Panel Text Size", options=["Tiny", "Small", "Normal"], group=g4b)
panelSize = panelSizeInput == "Tiny" ? size.tiny : panelSizeInput == "Normal" ? size.normal : size.small

// ================= 5. BODY-BREAK (TRIGGER) =================
g5b = "5. BODY-BREAK (TRIGGER)"
bodyBreakLineStyleInput = input.string("Dotted", "Body-Break Line Style", options=["Dotted", "Dashed", "Solid"], group=g5b)
// Body-break history count follows keepN (Displayed Setups)
keepBodyHistory = keepN

// ================= 6. COLORS =================
g6 = "6. COLORS"
cEntryLine = input.color(#787B86, "Entry Line", group=g6)
cSL = input.color(#EF5350, "Stop Loss", group=g6)
cTP = input.color(#26A69A, "Take Profit", group=g6)
cBodyBreak = input.color(#BDBDBD, "Body-Break", group=g6)
cBuyText = input.color(#26A69A, "BUY Text", group=g6)
cSellText = input.color(#EF5350, "SELL Text", group=g6)

// ================= DISPLAY SETTINGS =================
labelSize = labelSizeInput == "Tiny" ? size.tiny : labelSizeInput == "Normal" ? size.normal : labelSizeInput == "Large" ? size.large : size.small
selectedLineStyle = lineStyleInput == "Solid" ? line.style_solid : line.style_dashed
transparentLabel = color.new(color.black, 100)

// ================= BASE CALCULATION =================
atr = ta.atr(14)
bufEntry = bufEntryX * atr
bufSL = bufSLX * atr
bufBodyBreak = bodyBreakToleranceATR * atr

o1 = open[1]
c1 = close[1]

// --- reference points: selalu wick prev candle
pTopRef = high[1]
pBotRef = low[1]
rgPrev = high[1] - low[1]

bdCur = math.abs(close - open)

// ================= PATTERN DETECTION =================
engBull = patMode == "Strict" ? open <= pBotRef and close >= pTopRef : close > pTopRef
engBear = patMode == "Strict" ? open >= pTopRef and close <= pBotRef : close < pTopRef

okBodyX = rgPrev > 0 ? bdCur >= rgPrev * minBodyX : bdCur > 0
okBodyP = rgPrev > 0 and bdCur / rgPrev * 100.0 >= minBodyP
okAll = okBodyX and okBodyP

sigBuy = barstate.isconfirmed and close > open and c1 < o1 and engBull and okAll
sigSell = barstate.isconfirmed and close < open and c1 > o1 and engBear and okAll

// ================= STATE =================
var int state = 0
var int setupDir = 0
var int setupBar = na
var int entryBar = na

var float pBreak = na
var float pEntry = na
var float pSL = na
var float pTP = na

var line lnE = na
var line lnS = na
var line lnT = na

var label lbE = na
var label lbS = na
var label lbT = na

// arrays for regular setup lines/labels
var array<line> arrLn = array.new<line>()
var array<label> arrLb = array.new<label>()

// arrays for body-break history (store all created single body-break lines/labels)
var array<line> arrBodyLn = array.new<line>()
var array<label> arrBodyLb = array.new<label>()

// active single body-break references for current setup (so we can extend/freeze them)
var line lnBodyBreakActive = na
var label lbBodyBreakActive = na

// ================= STATISTICS =================
var int nSig = 0
var int nRun = 0
var int nWin = 0
var int nLos = 0
var int nCancelled = 0

var int nBuyRun = 0
var int nSellRun = 0

var int buyWins = 0
var int buyLoss = 0
var int sellWins = 0
var int sellLoss = 0

var int curTPStreak = 0
var int curSLStreak = 0
var int maxTPStreak = 0
var int maxSLStreak = 0

// ================= EVENT FLAGS =================
armedNow = false
hitBuy = false
hitSell = false
tpHitNow = false
slHitNow = false
cancelledNow = false
cancelledDir = 0

if sigBuy or sigSell
    nSig += 1

// ================= Helper: delete arrays safely =================
f_delete_lines_from_array(_arr) =>
    for i = 0 to array.size(_arr) - 1
        line.delete(array.get(_arr, i))
    array.clear(_arr)

f_delete_labels_from_array(_arr) =>
    for i = 0 to array.size(_arr) - 1
        label.delete(array.get(_arr, i))
    array.clear(_arr)

// ================= EXTEND ACTIVE SETUP =================
if state != 0
    xRight = bar_index + extendB

    if not na(lnE)
        line.set_x2(lnE, xRight)

    if not na(lnS)
        line.set_x2(lnS, xRight)

    if not na(lnT)
        line.set_x2(lnT, xRight)

    if not na(lbE)
        label.set_x(lbE, xRight)

    if not na(lbS)
        label.set_x(lbS, xRight)

    if not na(lbT)
        label.set_x(lbT, xRight)

    // extend active single body-break visual (if exists)
    if not na(lnBodyBreakActive)
        line.set_x2(lnBodyBreakActive, xRight)
    if not na(lbBodyBreakActive)
        label.set_x(lbBodyBreakActive, xRight)

// ================= OPPOSITE SIGNAL CANCELLATION =================
// state 1/2 = BUY menunggu trigger / pending aktif; -1/-2 = SELL. Cancel sebelum posisi terisi (3/-3).
oppositeToBuy = (state == 1 or state == 2) and sigSell
oppositeToSell = (state == -1 or state == -2) and sigBuy

if cancelOpp and (oppositeToBuy or oppositeToSell)
    cancelledDir := state > 0 ? 1 : -1
    nCancelled += 1
    cancelledNow := true
    state := 0

    // delete only setup visuals (lines & labels)
    f_delete_lines_from_array(arrLn)
    f_delete_labels_from_array(arrLb)

    lnE := na
    lnS := na
    lnT := na

    lbE := na
    lbS := na
    lbT := na

    // clear active single body-break references (history remains)
    lnBodyBreakActive := na
    lbBodyBreakActive := na

// ================= BREAK BODY TRIGGER (BUY) =================
if state == 1 and bar_index > setupBar
    if high >= pBreak
        state := 2
        armedNow := true

// ================= PENDING FILL (BUY) =================
if state == 2
    if high >= pEntry
        state := 3
        entryBar := bar_index

        nRun += 1
        nBuyRun += 1
        hitBuy := true

        if not na(lnE)
            line.set_style(lnE, line.style_solid)
            line.set_color(lnE, cBuyText)

        if not na(lbE)
            label.set_text(lbE, "BUY " + str.tostring(pEntry, format.mintick))
            label.set_textcolor(lbE, cBuyText)

// ================= BREAK BODY TRIGGER (SELL) =================
if state == -1 and bar_index > setupBar
    if low <= pBreak
        state := -2
        armedNow := true

// ================= PENDING FILL (SELL) =================
if state == -2
    if low <= pEntry
        state := -3
        entryBar := bar_index

        nRun += 1
        nSellRun += 1
        hitSell := true

        if not na(lnE)
            line.set_style(lnE, line.style_solid)
            line.set_color(lnE, cSellText)

        if not na(lbE)
            label.set_text(lbE, "SELL " + str.tostring(pEntry, format.mintick))
            label.set_textcolor(lbE, cSellText)

// ================= ACTIVE BUY RESULT =================
if state == 3 and bar_index > entryBar
    if low <= pSL
        nLos += 1
        buyLoss += 1

        curSLStreak += 1
        curTPStreak := 0
        maxSLStreak := math.max(maxSLStreak, curSLStreak)

        slHitNow := true
        state := 0

        if not na(lbE)
            label.set_text(lbE, "BUY SL " + str.tostring(pEntry, format.mintick))
            label.set_textcolor(lbE, cSL)

        if not na(lbS)
            label.set_text(lbS, "SL HIT " + str.tostring(pSL, format.mintick))
            label.set_textcolor(lbS, cSL)

    else if high >= pTP
        nWin += 1
        buyWins += 1

        curTPStreak += 1
        curSLStreak := 0
        maxTPStreak := math.max(maxTPStreak, curTPStreak)

        tpHitNow := true
        state := 0

        if not na(lbE)
            label.set_text(lbE, "BUY TP " + str.tostring(pEntry, format.mintick))
            label.set_textcolor(lbE, cTP)

        if not na(lbT)
            label.set_text(lbT, "TP HIT " + str.tostring(pTP, format.mintick))
            label.set_textcolor(lbT, cTP)

// ================= ACTIVE SELL RESULT =================
if state == -3 and bar_index > entryBar
    if high >= pSL
        nLos += 1
        sellLoss += 1

        curSLStreak += 1
        curTPStreak := 0
        maxSLStreak := math.max(maxSLStreak, curSLStreak)

        slHitNow := true
        state := 0

        if not na(lbE)
            label.set_text(lbE, "SELL SL " + str.tostring(pEntry, format.mintick))
            label.set_textcolor(lbE, cSL)

        if not na(lbS)
            label.set_text(lbS, "SL HIT " + str.tostring(pSL, format.mintick))
            label.set_textcolor(lbS, cSL)

    else if low <= pTP
        nWin += 1
        sellWins += 1

        curTPStreak += 1
        curSLStreak := 0
        maxTPStreak := math.max(maxTPStreak, curTPStreak)

        tpHitNow := true
        state := 0

        if not na(lbE)
            label.set_text(lbE, "SELL TP " + str.tostring(pEntry, format.mintick))
            label.set_textcolor(lbE, cTP)

        if not na(lbT)
            label.set_text(lbT, "TP HIT " + str.tostring(pTP, format.mintick))
            label.set_textcolor(lbT, cTP)

// ================= FREEZE COMPLETED SETUP =================
if tpHitNow or slHitNow
    xFinal = bar_index + extendB

    if not na(lnE)
        line.set_x2(lnE, xFinal)

    if not na(lnS)
        line.set_x2(lnS, xFinal)

    if not na(lnT)
        line.set_x2(lnT, xFinal)

    if not na(lbE)
        label.set_x(lbE, xFinal)

    if not na(lbS)
        label.set_x(lbS, xFinal)

    if not na(lbT)
        label.set_x(lbT, xFinal)

    // freeze active single body-break visual (it remains visible as history)
    if not na(lnBodyBreakActive)
        line.set_x2(lnBodyBreakActive, xFinal)
    if not na(lbBodyBreakActive)
        label.set_x(lbBodyBreakActive, xFinal)

    // clear active references (history copies remain in arrays)
    lnBodyBreakActive := na
    lbBodyBreakActive := na

// ================= CREATE NEW SETUP =================
if state == 0 and (sigBuy or sigSell)
    dir = sigBuy ? 1 : -1

    lnE := na
    lnS := na
    lnT := na

    lbE := na
    lbS := na
    lbT := na

    setupDir := dir
    setupBar := bar_index
    entryBar := na

    // --- levels: break body = trigger (body prev candle), entry = pending stop di wick
    wickTop = high[1]
    wickBot = low[1]
    bodyTopPrev = math.max(o1, c1)
    bodyBotPrev = math.min(o1, c1)

    breakCalc = dir == 1 ? bodyTopPrev + bufBodyBreak : bodyBotPrev - bufBodyBreak
    entryCalc = dir == 1 ? wickTop + bufEntry : wickBot - bufEntry

    // guard: break body tidak boleh melewati level pending
    if dir == 1 and breakCalc >= entryCalc
        breakCalc := entryCalc - syminfo.mintick
    if dir == -1 and breakCalc <= entryCalc
        breakCalc := entryCalc + syminfo.mintick

    // SL dari wick berlawanan, TP dari entry (wick)
    slCalc = dir == 1 ? wickBot - bufSL : wickTop + bufSL

    if dir == 1 and slCalc >= entryCalc
        slCalc := entryCalc - math.max(bufSL, syminfo.mintick * 2)

    if dir == -1 and slCalc <= entryCalc
        slCalc := entryCalc + math.max(bufSL, syminfo.mintick * 2)

    risk = math.abs(entryCalc - slCalc)
    tpCalc = dir == 1 ? entryCalc + rrRatio * risk : entryCalc - rrRatio * risk

    // draw body-break line (trigger level) when master display is on
    if showLines
        xStartBody = bar_index - 1
        xRightBody = bar_index + extendB

        lbStyle = bodyBreakLineStyleInput == "Dotted" ? line.style_dotted : bodyBreakLineStyleInput == "Dashed" ? line.style_dashed : line.style_solid
        lnBodyBreakActive := line.new(xStartBody, breakCalc, xRightBody, breakCalc, xloc=xloc.bar_index, color=cBodyBreak, width=1, style=lbStyle)
        array.push(arrBodyLn, lnBodyBreakActive)

        lbBodyBreakActive := label.new(xRightBody, breakCalc, "BREAK BODY", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=transparentLabel, textcolor=cBodyBreak, size=labelSize)
        array.push(arrBodyLb, lbBodyBreakActive)

        // limit history arrays to keepBodyHistory (which equals keepN)
        while array.size(arrBodyLn) > keepBodyHistory
            line.delete(array.shift(arrBodyLn))
        while array.size(arrBodyLb) > keepBodyHistory
            label.delete(array.shift(arrBodyLb))

    if risk > syminfo.mintick and math.abs(tpCalc - entryCalc) > syminfo.mintick
        pBreak := breakCalc
        pEntry := entryCalc
        pSL := slCalc
        pTP := tpCalc

        state := dir

        xEntryStart = bar_index
        xSLStart = bar_index - 1
        xRight = bar_index + extendB

        if showLines
            lnE := line.new(xEntryStart, pEntry, xRight, pEntry, xloc=xloc.bar_index, color=cEntryLine, width=1, style=line.style_dashed)
            lnS := line.new(xSLStart, pSL, xRight, pSL, xloc=xloc.bar_index, color=cSL, width=1, style=selectedLineStyle)
            lnT := line.new(xEntryStart, pTP, xRight, pTP, xloc=xloc.bar_index, color=cTP, width=1, style=selectedLineStyle)

            array.push(arrLn, lnE)
            array.push(arrLn, lnS)
            array.push(arrLn, lnT)

            side = dir == 1 ? "BUY" : "SELL"
            entryColor = dir == 1 ? cBuyText : cSellText

            lbE := label.new(xRight, pEntry, "PENDING " + side + " " + str.tostring(pEntry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=transparentLabel, textcolor=entryColor, size=labelSize)
            lbS := label.new(xRight, pSL, "SL " + str.tostring(pSL, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=transparentLabel, textcolor=cSL, size=labelSize)
            lbT := label.new(xRight, pTP, "TP " + str.tostring(pTP, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=transparentLabel, textcolor=cTP, size=labelSize)

            array.push(arrLb, lbE)
            array.push(arrLb, lbS)
            array.push(arrLb, lbT)

        while array.size(arrLn) > keepN * 3
            line.delete(array.shift(arrLn))

        while array.size(arrLb) > keepN * 3
            label.delete(array.shift(arrLb))

// ================= MASTER DISPLAY TOGGLE =================
// Tidak perlu handler hapus manual: perubahan input memicu recalculate penuh
// di Pine, semua line/label dibuat ulang dari nol sesuai showLines.

// ================= PANEL HELPER =================
f_prob(_wins, _closed) =>
    _closed > 0 ? str.tostring(float(_wins) / float(_closed) * 100.0, "#.##") + "%" : "n/a"

// ================= RESULTS PANEL =================
rows = 14
var table probabilityTable = table.new(position.top_right, 2, rows, border_color=color.new(color.gray, 40), border_width=1, frame_color=color.new(color.gray, 20), frame_width=1)
var bool probabilityTableMerged = false

if barstate.islast
    if not probabilityTableMerged
        table.merge_cells(probabilityTable, 0, 0, 1, 0)
        table.merge_cells(probabilityTable, 0, 1, 1, 1)
        table.merge_cells(probabilityTable, 0, 2, 1, 2)
        table.merge_cells(probabilityTable, 0, 6, 1, 6)
        table.merge_cells(probabilityTable, 0, rows - 1, 1, rows - 1)
        probabilityTableMerged := true

    if showTable
        closedTrades = nWin + nLos
        closedBuy = buyWins + buyLoss
        closedSell = sellWins + sellLoss

        statusText = state == 3 ? "BUY" : state == -3 ? "SELL" : state == 1 or state == 2 ? "PENDING BUY" : state == -1 or state == -2 ? "PENDING SELL" : "NONE"
        statusColor = state == 3 ? cBuyText : state == -3 ? cSellText : state == 1 or state == 2 ? cBuyText : state == -1 or state == -2 ? cSellText : color.silver

        transparentBg = color.new(color.black, 100)
        blockBg = color.new(color.gray, 85)
        neutralColor = color.white
        positiveColor = #26A69A
        negativeColor = #EF5350

        bodySize = panelSize
        headerSize = panelSize
        blockSize = panelSize
        pad = " "

        table.cell(probabilityTable, 0, 0, "Engulfing Breakout", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_center, text_size=headerSize)
        table.cell(probabilityTable, 0, 1, "By Syakir Arslan (modified)", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_center, text_size=panelSize)

        table.cell(probabilityTable, 0, 2, "SETUP", text_color=neutralColor, bgcolor=blockBg, text_halign=text.align_center, text_size=blockSize)

        table.cell(probabilityTable, 0, 3, pad + "R:R", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 3, pad + "1:" + str.tostring(rrRatio, "#.#"), text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 4, pad + "Status", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 4, pad + statusText, text_color=statusColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 5, pad + "Cancelled", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 5, pad + str.tostring(nCancelled), text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 6, "RESULTS", text_color=neutralColor, bgcolor=blockBg, text_halign=text.align_center, text_size=blockSize)

        table.cell(probabilityTable, 0, 7, pad + "Signals", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 7, pad + str.tostring(nSig), text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 8, pad + "Entries", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 8, pad + str.tostring(nRun), text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 9, pad + "Buy WR", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 9, pad + f_prob(buyWins, closedBuy) + " (" + str.tostring(nBuyRun) + ")", text_color=cBuyText, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 10, pad + "Sell WR", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 10, pad + f_prob(sellWins, closedSell) + " (" + str.tostring(nSellRun) + ")", text_color=cSellText, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 11, pad + "Max TP Run", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 11, pad + str.tostring(maxTPStreak), text_color=positiveColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 12, pad + "Max SL Run", text_color=neutralColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)
        table.cell(probabilityTable, 1, 12, pad + str.tostring(maxSLStreak), text_color=negativeColor, bgcolor=transparentBg, text_halign=text.align_left, text_size=bodySize)

        table.cell(probabilityTable, 0, 13, "Overall: " + f_prob(nWin, closedTrades), text_color=neutralColor, bgcolor=blockBg, text_halign=text.align_center, text_size=headerSize)
    else
        table.clear(probabilityTable, 0, 0, 1, rows - 1)

// ================= ALERT CONDITIONS =================
alertcondition(armedNow, title="Break Body Triggered", message="Break body touched - pending order armed at wick.")
alertcondition(hitBuy, title="BUY Entry Active", message="BUY Entry is active.")
alertcondition(hitSell, title="SELL Entry Active", message="SELL Entry is active.")
alertcondition(tpHitNow, title="Take Profit Hit", message="The active position reached Take Profit.")
alertcondition(slHitNow, title="Stop Loss Hit", message="The active position reached Stop Loss.")
alertcondition(cancelledNow, title="Setup Cancelled", message="The setup was cancelled before Entry.")

// dynamic alerts
if armedNow
    armedSide = state == 2 ? "BUY" : "SELL"
    alert(syminfo.ticker + " " + timeframe.period + " | BREAK BODY TRIGGERED " + armedSide + " | PENDING @ " + str.tostring(pEntry, format.mintick), alert.freq_once_per_bar)

if hitBuy or hitSell
    entrySide = hitBuy ? "BUY" : "SELL"
    alert(syminfo.ticker + " " + timeframe.period + " | ENTRY " + entrySide + " @ " + str.tostring(pEntry, format.mintick) + " | SL " + str.tostring(pSL, format.mintick) + " | TP " + str.tostring(pTP, format.mintick), alert.freq_once_per_bar)

if tpHitNow
    resultSideTP = setupDir == 1 ? "BUY" : "SELL"
    alert(syminfo.ticker + " " + timeframe.period + " | TP HIT " + resultSideTP + " @ " + str.tostring(pTP, format.mintick), alert.freq_once_per_bar)

if slHitNow
    resultSideSL = setupDir == 1 ? "BUY" : "SELL"
    alert(syminfo.ticker + " " + timeframe.period + " | SL HIT " + resultSideSL + " @ " + str.tostring(pSL, format.mintick), alert.freq_once_per_bar)

if cancelledNow
    cancelledSideAlert = cancelledDir == 1 ? "BUY" : "SELL"
    alert(syminfo.ticker + " " + timeframe.period + " | CANCELLED " + cancelledSideAlert + " | SL " + str.tostring(pSL, format.mintick), alert.freq_once_per_bar)
